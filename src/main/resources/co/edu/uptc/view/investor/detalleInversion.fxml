<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="scroll-container" stylesheets="@../../css/misInversiones.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uptc.viewcontroller.investor.DetalleInversionController">
    <content>
        <VBox spacing="25.0" styleClass="root-container">
            <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>

            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <Button mnemonicParsing="false" onAction="#volverAInversiones" styleClass="btn-back" text="← Volver a Mis Inversiones" />
                <Region HBox.hgrow="ALWAYS" />
                <Label styleClass="badge-status-active" text="Activa" />
            </HBox>
            
            <Label fx:id="lblNombreActivo" styleClass="header-title-details" text="Cargando Activo..." />

            <HBox spacing="15.0">
                <VBox spacing="5.0" styleClass="mini-card-metrics" HBox.hgrow="ALWAYS">
                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                    <Label styleClass="mini-card-label" text="Inversión Inicial" />
                    <Label fx:id="lblMontoInicial" styleClass="mini-card-value" text="\$0.00" />
                </VBox>
                <VBox spacing="5.0" styleClass="mini-card-metrics-highlight" HBox.hgrow="ALWAYS">
                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                    <Label styleClass="mini-card-label" text="Valor Actual" />
                    <Label fx:id="lblValorActual" styleClass="mini-card-value" text="\$0.00" />
                </VBox>
                <VBox spacing="5.0" styleClass="mini-card-metrics" HBox.hgrow="ALWAYS">
                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                    <Label styleClass="mini-card-label" text="Rendimiento" />
                    <HBox alignment="CENTER_LEFT" spacing="5.0">
                        <Label styleClass="mini-card-value-green" text="+ 17.00%" />
                        <Label styleClass="mini-card-arrow" text="▲" />
                    </HBox>
                </VBox>
            </HBox>

            <VBox spacing="10.0" styleClass="card-dark">
                <padding><Insets bottom="15.0" left="10.0" right="20.0" top="20.0" /></padding>
                <Label styleClass="card-label-small" text="Rendimiento Histórico (Desde la compra)" />
                <LineChart fx:id="chartRendimiento" horizontalGridLinesVisible="false" legendVisible="false" prefHeight="220.0" verticalGridLinesVisible="false">
                    <xAxis>
                        <CategoryAxis side="BOTTOM" tickLabelFill="#94a3b8" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis side="LEFT" tickLabelFill="#94a3b8" />
                    </yAxis>
                </LineChart>
            </VBox>

            <VBox spacing="1.0" styleClass="attributes-table-container">
                <padding><Insets bottom="5.0" top="5.0" /></padding>
                <HBox styleClass="attr-row-header">
                    <padding><Insets bottom="12.0" left="15.0" right="15.0" top="12.0" /></padding>
                    <Label styleClass="attr-header-text" text="Activo / Unidades" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label styleClass="attr-header-text" text="Estado" />
                </HBox>
                <HBox styleClass="attr-row">
                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                    <VBox spacing="3.0">
                        <Label styleClass="attr-name-bold" text="Detalles del Capital" />
                        <Label fx:id="lblUnidades" styleClass="attr-subname" text="0.0000 unidades" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <VBox alignment="CENTER_RIGHT" spacing="3.0">
                        <Label styleClass="attr-value" text="Fondos Bloqueados" />
                    </VBox>
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>