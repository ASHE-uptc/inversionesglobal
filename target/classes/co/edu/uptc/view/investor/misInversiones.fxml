<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane stylesheets="@../../css/misInversiones.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uptc.viewcontroller.investor.MisInversionesController">
    
    <ScrollPane fitToWidth="true" styleClass="scroll-container">
        <content>
            <VBox spacing="20.0" styleClass="root-container">
                <padding>
                    <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                </padding>

                <VBox spacing="5.0" minHeight="-Infinity">
                    <Label styleClass="header-title" text="%misinversiones.hello" wrapText="true" />
                    <Label styleClass="header-subtitle" text="%misinversiones.welcome" wrapText="true" />
                </VBox>

                <VBox spacing="5.0" styleClass="card-balance-box" minHeight="-Infinity">
                    <padding>
                        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
                    </padding>
                    <Label styleClass="card-label-small" text="%misinversiones.balance.label" />
                    <Label fx:id="saldoLabel" styleClass="card-balance" text="0.00" />
                </VBox>

                <VBox fx:id="containerEstadoVacio" alignment="CENTER" styleClass="card-dark" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="40.0" left="20.0" right="20.0" top="40.0" />
                    </padding>
                    <StackPane styleClass="icon-container">
                        <ImageView fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                            <Image url="@../images/lupa_icon.png" />
                        </ImageView>
                    </StackPane>
                    <Label styleClass="empty-state-title" text="%misinversiones.empty.title" />
                    <Label styleClass="empty-state-subtitle" text="%misinversiones.empty.subtitle" />
                    <Button mnemonicParsing="false" onAction="#abrirModal" styleClass="btn-pill-primary" text="%misinversiones.empty.btn">
                        <VBox.margin><Insets top="20.0" /></VBox.margin>
                    </Button>
                </VBox>

                <VBox fx:id="containerListaInversiones" spacing="15.0" visible="false" managed="false" VBox.vgrow="ALWAYS">
                    
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="header-subtitle" text="%misinversiones.list.title" style="-fx-font-weight: bold; -fx-text-fill: white;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#abrirModal" styleClass="btn-pill-primary" text="%misinversiones.list.newbtn" />
                    </HBox>
                    
                    <VBox fx:id="listaInversionesVBox" spacing="12.0" />
                </VBox>

            </VBox>
        </content>
    </ScrollPane>

    <StackPane fx:id="modalOverlay" styleClass="modal-overlay" visible="false">
        <VBox maxHeight="-Infinity" maxWidth="420.0" spacing="20.0" styleClass="modal-card">
            <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
            
            <Label styleClass="modal-title" text="%misinversiones.modal.title" />
            
            <VBox spacing="6.0">
                <Label styleClass="input-label" text="%misinversiones.modal.select" />
                <ComboBox fx:id="comboActivos" maxWidth="Infinity" styleClass="modal-combo" />
            </VBox>
            
            <VBox spacing="6.0">
                <Label styleClass="input-label" text="%misinversiones.modal.amount" />
                <TextField fx:id="txtMonto" promptText="0.00" styleClass="modal-input" />
            </VBox>
            
            <HBox alignment="CENTER_RIGHT" spacing="12.0">
                <Button mnemonicParsing="false" onAction="#cerrarModal" styleClass="btn-modal-secondary" text="%misinversiones.modal.cancel" />
                <Button mnemonicParsing="false" onAction="#confirmarInversion" styleClass="btn-modal-primary" text="%misinversiones.modal.confirm" />
            </HBox>
        </VBox>
    </StackPane>
</StackPane>