<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="scroll-container" stylesheets="@../../css/misInversiones.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uptc.viewcontroller.investor.DetalleInversionController">
    <content>
        <VBox spacing="25.0" styleClass="root-container">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <Button mnemonicParsing="false" onAction="#volverAInversiones" styleClass="btn-back" text="%detalle.btn.back" />
                <Region HBox.hgrow="ALWAYS" />
                <Label styleClass="badge-status-active" text="%detalle.status.active" />
            </HBox>
            
            <Label fx:id="lblNombreActivo" styleClass="header-title-details" text="%detalle.loading.asset" />

            <HBox spacing="15.0">
                <VBox spacing="5.0" styleClass="mini-card-metrics" HBox.hgrow="ALWAYS">
                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                    <Label styleClass="mini-card-label" text="%detalle.label.initial" />
                    <Label fx:id="lblMontoInicial" styleClass="mini-card-value" text="0.00" />
                </VBox>
                
                <VBox spacing="5.0" styleClass="mini-card-metrics-highlight" HBox.hgrow="ALWAYS">
                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                    <Label styleClass="mini-card-label" text="%detalle.label.current" />
                    <Label fx:id="lblValorActual" styleClass="mini-card-value" text="0.00" />
                </VBox>
                
                <VBox spacing="5.0" styleClass="mini-card-metrics" HBox.hgrow="ALWAYS">
                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                    <Label styleClass="mini-card-label" text="%detalle.label.performance" />
                    <HBox alignment="CENTER_LEFT" spacing="5.0">
                        <Label fx:id="lblPorcentajeRendimiento" styleClass="mini-card-value" text="0.00%" />
                    </HBox>
                </VBox>
            </HBox>

            <VBox spacing="1.0" styleClass="attributes-table-container">
                <padding><Insets bottom="5.0" top="5.0" /></padding>
                
                <HBox styleClass="attr-row-header">
                    <padding><Insets bottom="12.0" left="15.0" right="15.0" top="12.0" /></padding>
                    <Label styleClass="attr-header-text" text="%detalle.table.header.asset" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label styleClass="attr-header-text" text="%detalle.table.header.status" />
                </HBox>
                
                <HBox styleClass="attr-row">
                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                    <VBox spacing="3.0">
                        <Label styleClass="attr-name-bold" text="%detalle.table.row.title" />
                        <Label fx:id="lblUnidades" styleClass="attr-subname" text="0.0000 unidades" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <VBox alignment="CENTER_RIGHT" spacing="3.0">
                        <Label styleClass="attr-value" text="%detalle.table.row.status" />
                    </VBox>
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>